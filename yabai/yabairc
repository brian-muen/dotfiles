yabai -m signal --add event=dock_did_restart action="sudo -n yabai --load-sa"
sudo -n yabai --load-sa 2>/dev/null || true

# Set the defaul tiling option to bsp (floating also available)
yabai -m config layout bsp

# Label macOS Spaces so yabai can target them by purpose.
# Make sure you have at least five macOS Spaces in Mission Control.
yabai -m space 1 --label _space_1
yabai -m space 2 --label _space_2
yabai -m space 3 --label _space_3
yabai -m space 4 --label _space_4
yabai -m space 5 --label _space_5

yabai -m space 1 --label home
yabai -m space 2 --label terminal
yabai -m space 3 --label arc
yabai -m space 4 --label files
yabai -m space 5 --label emacs

# Use stack layout for app-dedicated Spaces that should not subdivide.
yabai -m space home --layout bsp
yabai -m space terminal --layout bsp
yabai -m space arc --layout stack
yabai -m space files --layout stack
yabai -m space emacs --layout stack

# Set padding between windows.
# SketchyBar is reserved with external_bar below. Keep top_padding at zero
# so the bar reservation is not applied twice.
yabai -m config top_padding    0
yabai -m config bottom_padding 0
yabai -m config left_padding   0
yabai -m config right_padding  0
yabai -m config window_gap     0

# Turn auto balance on or off (default: off)
# Auto balance tries to keep all windows around the same size. probably keep it off, it's janky
yabai -m config auto_balance off

# Set mouse interaction modifier key (default: fn)
yabai -m config mouse_modifier fn

# Set modifier + left-click drag to move window (default: move)
yabai -m config mouse_action1 move

# Set modifier + right-click drag to resize window (default: resize)
yabai -m config mouse_action2 resize

# Set focus follows mouse mode (default: off, options: off, autoraise, autofocus)
# Keep this off so floating utility windows do not disappear behind tiled windows
# when the pointer leaves them.
yabai -m config focus_follows_mouse off

# Set mouse follows focus mode (default: off)
yabai -m config mouse_follows_focus off

# Modify window shadows (default: on, options: on, off, float)
yabai -m config window_shadow off

# Skip some window focus animations. Keep off if using the scripting addition.
yabai -m config skip_window_focus_animation off

# Window opacity (default: off)
# yabai -m config window_opacity on
# yabai -m config active_window_opacity 1.0
# yabai -m config normal_window_opacity 0.9

# Set window animations on
# yabai -m config window_animation_duration 0.15
# yabai -m config window_animation_easing ease_out_circ

# Add exceptions to tiling
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^java$" manage=off
yabai -m rule --add app="^Claude$" manage=off
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Messages$" manage=off
yabai -m rule --add app="^Spotify$" manage=off
yabai -m rule --add app="^(Passwords|1Password|Bitwarden|Password Depot)$" manage=off
yabai -m rule --add app="^Windows( App)?$" manage=off

# Route main work apps to dedicated macOS Spaces.
yabai -m rule --add app="^Arc$" space=3
yabai -m rule --add app="^Cursor$" space=home
yabai -m rule --add app="^Ghostty$" title="^Lain Matrix$" space=1 manage=off grid=24:24:2:7:6:5
yabai -m rule --add app="^Ghostty$" title="^Lain Clock$" space=1 manage=off grid=24:24:8:7:8:5
yabai -m rule --add app="^Ghostty$" title="^Lain Shell$" space=1 manage=off grid=24:24:2:12:14:9
yabai -m rule --add app="^(Ghostty|Terminal|iTerm2|kitty|WezTerm|Alacritty)$" space=terminal
yabai -m rule --add app="^Emacs$" space=emacs
yabai -m rule --add app="^Preview$" space=files

# Jankyborders
borders active_color=0xffff7a99 inactive_color=0xff4d4d4d width=5.0 hidpi=on

# Add padding for SketchyBar on the main display only. The SketchyBar window is
# 38px tall, with visible item backgrounds centered in that area.
yabai -m config external_bar main:38:0
# The same as above, but for all displays instead
# yabai -m config external_bar all:43:0
