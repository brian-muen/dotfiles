{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "macos",
        "color": {
            "1": "#b4637a",
            "2": "#d7827e",
            "3": "#ea9d34",
            "4": "#56949f",
            "5": "#907aa9"
        },
        "padding": {
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#907aa9",
            "title": "#d7827e",
            "output": "#575279",
            "separator": "#9893a5"
        },
        "brightColor": false,
        "size": {
            "maxPrefix": "MB",
            "ndigits": 0,
            "spaceBeforeUnit": "never"
        },
        "freq": {
            "ndigits": 3,
            "spaceBeforeUnit": "never"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        {
            "type": "kernel",
            "format": "{release}"
        },
        "uptime",
        {
            "type": "packages",
            "combined": true
        },
        "shell",
        "terminal",
        "cpu",
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "format": "{used} / {total}"
        },
        "break",
        "colors"
    ]
}
