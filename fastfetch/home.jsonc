{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/assets/lain/fetch_image.png",
        "type": "chafa",
        "width": 30,
        "height": 14,
        "preserveAspectRatio": true,
        "recache": true,
        "padding": {
            "right": 2
        },
        "chafa": {
            "fgOnly": false,
            "symbols": "block+border+space-wide-inverted"
        }
    },
    "display": {
        "pipe": false,
        "separator": ": ",
        "color": {
            "keys": "#ff7a99",
            "title": "#ff7a99",
            "output": "#f8f8f2",
            "separator": "#f8f8f2"
        },
        "brightColor": true,
        "showErrors": false,
        "size": {
            "maxPrefix": "GB",
            "ndigits": 0,
            "spaceBeforeUnit": "never"
        }
    },
    "modules": [
        {
            "type": "custom",
            "key": "OS",
            "format": "Copland OS"
        },
        {
            "type": "custom",
            "key": "Host",
            "format": "NAVI"
        },
        {
            "type": "command",
            "key": "Kernel",
            "text": "uname -r",
            "format": "{result}"
        },
        "shell",
        "cpu",
        {
            "type": "disk",
            "folders": "/",
            "format": "{size-used}/{size-total}"
        }
    ]
}
