{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/assets/lain/fastfetch-lain-color.ansi",
        "type": "file-raw",
        "padding": {
            "right": 4
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "#ff7a99",
            "title": "#ff7a99",
            "output": "#f8f8f2",
            "separator": "#f8f8f2"
        },
        "brightColor": true,
        "showErrors": false,
        "size": {
            "maxPrefix": "GB",
            "ndigits": 2,
            "spaceBeforeUnit": "never"
        },
        "freq": {
            "ndigits": 3,
            "spaceBeforeUnit": "never"
        }
    },
    "modules": [
        "title",
        {
            "type": "publicip",
            "url": "http://ident.me",
            "timeout": 2000
        },
        "separator",
        {
            "type": "custom",
            "key": "OS",
            "format": "Copland OS Enterprise"
        },
        {
            "type": "custom",
            "key": "Host",
            "format": "NAVI"
        },
        {
            "type": "command",
            "key": "Kernel",
            "text": "uname -r",
            "format": "{result}"
        },
        {
            "type": "packages",
            "combined": false
        },
        "shell",
        "de",
        "wm",
        {
            "type": "wmtheme",
            "key": "WM Theme"
        },
        "cpu",
        {
            "type": "command",
            "key": "GPU",
            "text": "system_profiler SPDisplaysDataType | awk -F': ' '/Chipset Model/ { print $2; exit }'",
            "format": "{result}"
        },
        {
            "type": "disk",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "command",
            "key": "Uptime",
            "text": "perl -MTime::Piece -e '$b=qx(who -b); $b=~/(\\w+\\s+\\d+\\s+\\d+:\\d+)/; $t=Time::Piece->strptime(\"$1 \".(localtime)->year,\"%b %d %H:%M %Y\"); $s=time-$t->epoch; printf \"%d days, %d hours, %d mins\\n\",$s/86400,$s/3600%24,$s/60%60'",
            "format": "{result}"
        },
        "break",
        {
            "type": "command",
            "key": " ",
            "text": "printf '\\033[48;2;0;0;0m   \\033[48;2;255;79;125m   \\033[48;2;255;156;181m   \\033[48;2;255;230;163m   \\033[48;2;77;55;64m   \\033[48;2;255;122;153m   \\033[48;2;246;182;200m   \\033[48;2;248;248;242m   \\033[0m'",
            "format": "{result}"
        },
        {
            "type": "command",
            "key": " ",
            "text": "printf '\\033[48;2;25;19;22m   \\033[48;2;190;97;117m   \\033[48;2;255;116;149m   \\033[48;2;255;195;165m   \\033[48;2;42;26;30m   \\033[48;2;255;137;166m   \\033[48;2;255;208;218m   \\033[48;2;255;255;250m   \\033[0m'",
            "format": "{result}"
        }
    ]
}
